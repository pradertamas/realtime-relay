# Documentation only. server.js does not load .env files; inject OS/Render env vars.
# Keep real values outside Git. Never place Cloudflare credentials in clients.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Operator-only native sender gate: 32-256 random ASCII letters/digits/_/-.
# This is a DIFFERENT secret from the Cloudflare API token.
TURN_ENDPOINT_ACCESS_TOKEN=
# Configured cost assumption; not a contractual billing rate.
TURN_USD_PER_GB=0.05
